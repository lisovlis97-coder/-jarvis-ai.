{
  "name": "jarvis-windows",
  "version": "1.0.0",
  "private": true,
  "description": "J.A.R.V.I.S. Windows desktop application",
  "main": "main.cjs",
  "author": "Vector AI",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ru.vector.jarvis",
    "productName": "J.A.R.V.I.S.",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "JARVIS-Setup-${version}-${arch}.${ext}"
    },
    "artifactName": "JARVIS-${version}-${arch}.${ext}",
    "portable": {
      "artifactName": "JARVIS-Portable-${version}-${arch}.${ext}"
    }
  }
}
